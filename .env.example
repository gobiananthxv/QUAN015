# =============================================================================
# QMAFIB — Environment Configuration Template
# Copy this file to .env and customize the values for your environment:
#   cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# Server & Dashboard Ports (optional, defaults shown)
# -----------------------------------------------------------------------------
API_PORT=8000
UI_PORT=5173

# -----------------------------------------------------------------------------
# Capability boundary  (see backend/app/security.py)
# -----------------------------------------------------------------------------
# Five endpoints have effects outside this process: they overwrite the market
# data snapshot, send mail, or spend a metered AI provider key. Set a token and
# those five require it; leave it blank and they do not.
#
# Blank is a defensible default ONLY because the server binds 127.0.0.1. If you
# ever serve the dashboard on a network — a demo laptop on conference wifi, a
# deployed instance — set this first. Any random string will do:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
#
# VITE_QMAFIB_TOKEN must equal QMAFIB_TOKEN. It is a second variable only
# because Vite exposes VITE_-prefixed names to the browser and nothing else.
# It is baked into the bundle and readable in devtools: this raises the cost of
# scripted abuse, it is not authentication.
QMAFIB_TOKEN=
VITE_QMAFIB_TOKEN=

# Who may receive the report archive from POST /api/report/send-email.
# Comma-separated. An entry starting with @ matches a whole domain:
#   REPORT_EMAIL_ALLOWLIST=me@example.com,@myteam.org
# Left blank this falls back to SMTP_FROM (then SMTP_USER) — you can mail the
# archive to yourself and nowhere else. That endpoint attaches everything under
# backend/output, so it fails closed by design; an empty allowlist is a
# restriction, never a wildcard.
REPORT_EMAIL_ALLOWLIST=

# -----------------------------------------------------------------------------
# SMTP Email Delivery (for Reports)
# -----------------------------------------------------------------------------
# Configure your SMTP server details to send reports via email.
# For Gmail: Use smtp.gmail.com, port 587, with TLS enabled and an App Password.
# Note: For Gmail, generate an App Password from Google Account Security settings.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=your-email@gmail.com
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# -----------------------------------------------------------------------------
# External AI Services (Optional)
# -----------------------------------------------------------------------------
# Featherless API key for financial assistant chatbot
api_key=your_featherless_api_key

# Google Gemini API key for live news sentiment analysis
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_SEARCH_GROUNDING=false
