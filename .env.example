```env
# =============================================================================
# QMAFIB — Environment Configuration
# =============================================================================
# Copy this file to .env and customize as needed.
#
#   cp .env.example .env
# =============================================================================


# -----------------------------------------------------------------------------
# Server & Dashboard Ports
# -----------------------------------------------------------------------------
API_PORT=8000
UI_PORT=5173


# -----------------------------------------------------------------------------
# Capability Boundary
# -----------------------------------------------------------------------------
# Five endpoints have effects outside this process: they overwrite the market
# data snapshot, send mail, or spend a metered AI provider key.
#
# Set a token to protect those endpoints.
# Leave blank only when the server is bound to 127.0.0.1.
#
# Generate a secure token with:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
#
# VITE_QMAFIB_TOKEN must equal QMAFIB_TOKEN.
# VITE_-prefixed variables are exposed to the browser and therefore are NOT
# authentication secrets. They only raise the cost of scripted abuse.
# -----------------------------------------------------------------------------
QMAFIB_TOKEN=Abcdefg
VITE_QMAFIB_TOKEN=Abcdefg


# -----------------------------------------------------------------------------
# Report Email Allowlist
# -----------------------------------------------------------------------------
# Controls who may receive the report archive from:
#   POST /api/report/send-email
#
# Comma-separated email addresses or domains.
#
# Examples:
#   REPORT_EMAIL_ALLOWLIST=me@example.com
#   REPORT_EMAIL_ALLOWLIST=me@example.com,@myteam.org
#
# An entry beginning with @ matches the entire domain.
#
# If left blank, this falls back to SMTP_FROM, then SMTP_USER.
# This endpoint attaches everything under backend/output and fails closed.
# An empty allowlist is therefore a restriction, NOT a wildcard.
# -----------------------------------------------------------------------------
REPORT_EMAIL_ALLOWLIST=gobiananth0x@gmail.com


# -----------------------------------------------------------------------------
# SMTP Email Delivery
# -----------------------------------------------------------------------------
# Used for ML market-regime PDF reports and other report emails.
#
# Gmail:
#   Host: smtp.gmail.com
#   Port: 587
#   TLS: enabled
#
# For Gmail, use a Google App Password rather than your normal account
# password.
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=gobiananthag@gmail.com
SMTP_PASSWORD=bswpugbnxqysvhzl
SMTP_FROM=gobiananthag@gmail.com
SMTP_USE_TLS=true
SMTP_USE_SSL=false


# -----------------------------------------------------------------------------
# External AI Services
# -----------------------------------------------------------------------------

# Featherless API key for the financial assistant chatbot
api_key=


# Google Gemini API key for live news sentiment analysis
GEMINI_API_KEY=
# Gemini model used by the application
GEMINI_MODEL=gemini-3.5-flash-lite

# Enable/disable Gemini Search Grounding
GEMINI_SEARCH_GROUNDING=false
```
